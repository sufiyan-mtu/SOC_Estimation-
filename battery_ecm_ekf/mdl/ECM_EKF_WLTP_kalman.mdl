      <P Name="subviewer">64</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Vrc2_next = Vrc2_ZOH(R2, C2, Ts, I, Vrc2_prev)
% Exact ZOH update for fast RC branch
% Guards
R2 = min(max(R2, 1e-6), 10);
C2 = min(max(C2, 1e-6), 1e6);

tau1 = R2 * C2;
a    = exp( - Ts / tau1 );
b    = (1 - a) * R2;

Vrc2_next = a * Vrc2_prev + b * I;
end
</P>
      </eml>
    </state>
