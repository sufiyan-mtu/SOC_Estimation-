<?xml version="1.0" encoding="utf-8"?>
<ModelInformation Version="1.0">
  <Model>
    <P Name="ModelUUID">7d9d626d-87cb-4ecc-a03c-d4f5e38bc8e4</P>
    <P Name="PreLoadFcn">% PreLoadFcn — add repo root to MATLAB path before model loads
try
    mdlName = bdroot;
    mdlFile = get_param(mdlName,&apos;FileName&apos;);
    mdlDir  = fileparts(mdlFile);
    repoRoot = fileparts(mdlDir);


    addpath(genpath(repoRoot));
    cd(repoRoot);   % ensure relative paths work while loading
catch ME
    warning(&apos;PreLoadFcn path init failed: %s&apos;, ME.message);
end</P>
    <P Name="PostLoadFcn">% LoadFcn — run scripts after model loads
try
    setup_ecm;               % 1) create/overwrite data dictionary with LUTs
    setup_ekf;               % 2) upsert EKF params into dictionary
    Measured_data_import;    % 3) import measured data to base workspace
    fprintf(&apos;[%s] Auto-init complete.\n&apos;, bdroot);
catch ME
    warning(&apos;LoadFcn auto-init failed: %s&apos;, ME.message);
end</P>
    <P Name="DataDictionary">ecm_dd.sldd</P>
    <P Name="StopFcn">try, make_ecm_report; catch ME, disp(getReport(ME,&apos;extended&apos;)); end;
try, make_ekf_report; catch ME, disp(getReport(ME,&apos;extended&apos;)); end;</P>
