<?xml version="1.0" encoding="utf-8"?>
<chart id="30">
  <P Name="name">Subsystem/MATLAB Function3</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">30</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">17</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">4</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">Vrc_FOHZOH</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">30</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">
function [V_next, mode_used, a] = Vrc_FOHZOH(R, C, Ts, I_prev, I_cur, V_prev, dIdt_thr, force_mode)
% Hybrid FOH/ZOH update for a single RC branch, without charge-preservation.
% ZOH is exact for staircase inputs; FOH is exact for piecewise-linear ramps.

% ---------- Guards ----------
R  = min(max(R,  1e-6), 10);      % ohm
C  = min(max(C,  1e-6), 1e8);     % F (slow branch can be large)
Ts = max(Ts, 1e-6);               % s
tau = R * C;
a   = exp(-Ts / tau);             % exact decay factor

% ZOH (exact for holds): V[k] = a*V[k-1] + (1-a)*R*I[k-1]
Vzoh = a * V_prev + (1 - a) * R * I_prev;

% FOH (exact for ramps within the sample):
% Coefficients satisfy B_prev + B_cur = R*(1 - a)
B_prev = R - R * (tau/Ts) * (1 - a);
B_cur  = R * (tau/Ts) * (1 - a) - R * a;
Vfoh   = a * V_prev + B_prev * I_prev + B_cur * I_cur;

% ---------- Mode selection with hysteresis ----------
persistent last_mode
if isempty(last_mode), last_mode = 0; end             % start in ZOH
if force_mode == 0
    mode = 0;                                         % force ZOH
elseif force_mode == 1
    mode = 1;                                         % force FOH
else
    dIdt = (I_cur - I_prev) / Ts;
    if last_mode == 0 &amp;&amp; abs(dIdt) &gt; dIdt_thr
        mode = 1;                                     % ZOH -&gt; FOH on strong ramp
    elseif last_mode == 1 &amp;&amp; abs(dIdt) &lt; 0.7 * dIdt_thr
        mode = 0;                                     % FOH -&gt; ZOH when ramp weakens
    else
        mode = last_mode;                             % hold mode (avoid chatter)
    end
end

% ---------- Output ----------
V_next    = (mode==1) * Vfoh + (mode==0) * Vzoh;
mode_used = mode;
last_mode = mode;

% Optional clamp for sanity
V_next = min(max(V_next, -1e3), 1e3);
end
</P>
      </eml>
    </state>
    <data SSID="4" name="R">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
